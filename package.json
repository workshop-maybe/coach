{
  "name": "andamio-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "site:dev": "cd site && ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "site:build": "vitest run site/tests src/theme/brand.test.ts && cd site && ASTRO_TELEMETRY_DISABLED=1 astro build && pagefind --site dist",
    "site:preview": "cd site && ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "site:shots": "node scripts/shots.mjs",
    "site:examples": "vitest run site/tests/deepDive.test.ts -u"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/fragment-mono": "^5.3.0",
    "@remotion/player": "4.0.529",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tiptap/extension-document": "^3.31.3",
    "@tiptap/extension-list": "^3.31.3",
    "@tiptap/extension-paragraph": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remotion": "4.0.529",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/react": "^7.0.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "astro": "^7.3.5",
    "jsdom": "^30.1.1",
    "pagefind": "^1.5.2",
    "playwright": "^1.63.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.2"
  }
}
